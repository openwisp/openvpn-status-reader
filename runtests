#!/usr/bin/env bash
# Run the test suite or selected tests.
set -euo pipefail

# Require a test name before parameter IDs so pytest cannot treat them as paths.
test_pattern='^tests/([[:alnum:]_]+/)*test_[[:alnum:]_]+\.py'
# Parameter IDs can contain addresses, option values, and nested brackets.
test_pattern+='((::[[:alnum:]_.-]+)*::test_[[:alnum:]_.-]+\[([[:alnum:]_.:/= -]|\[|\])+\]|(::[[:alnum:]_.-]+)*)$'
for argument in "$@"; do
  case "$argument" in
    tests|-q|-v|-x|--cov-report=xml) continue ;;
  esac
  if [[ ! "$argument" =~ $test_pattern ]]; then
    echo "Unsupported test argument: $argument" >&2
    exit 2
  fi
done

exec python -m pytest "$@"
